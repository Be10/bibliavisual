---
import { sitePath } from "../../lib/site-paths";
---

<div class="gramophone-object" data-gramophone>
  <img
    class="gramophone-object__base"
    src={sitePath("/assets/study-room/audio/gramophone-base.png")}
    alt=""
    loading="lazy"
    decoding="async"
  />

  <span class="gramophone-object__record-plane" data-gramophone-record>
    <span class="gramophone-object__record-surface"></span>
    <span class="gramophone-object__record-label" aria-hidden="true"></span>
  </span>

  <img
    class="gramophone-object__arm"
    src={sitePath("/assets/study-room/audio/gramophone-arm.png")}
    alt=""
    loading="lazy"
    decoding="async"
  />

  <div class="gramophone-object__notes" aria-hidden="true">
    <span class="gramophone-object__note gramophone-object__note--one">♪</span>
    <span class="gramophone-object__note gramophone-object__note--two">♫</span>
    <span class="gramophone-object__note gramophone-object__note--three">♩</span>
    <span class="gramophone-object__note gramophone-object__note--four">♬</span>
  </div>
</div>

<style>
  .gramophone-object {
    /*
      IMPORTANTE:
      El gramófono usa assets 1024x1024.
      Este contenedor debe mantenerse cuadrado para que el disco,
      el brazo y las notas no cambien de proporción al redimensionar.
    */
    position: relative;
    aspect-ratio: 1 / 1;

    /*
      Usa la altura disponible de la tarjeta, pero nunca excede el ancho.
      Esto evita que el objeto se estire en contenedores rectangulares.
    */
    height: min(100%, 260px);
    width: auto;
    max-width: 100%;

    margin: auto;
    min-height: 120px;
    isolation: isolate;

    transition:
      transform 180ms ease,
      filter 180ms ease;
  }

  .gramophone-object:hover,
  .gramophone-object:focus-within {
    transform: translateY(-2px);
    filter:
      drop-shadow(0 0 8px rgba(230, 201, 121, 0.26))
      drop-shadow(0 0 18px rgba(230, 201, 121, 0.14));
  }

  .gramophone-object__base,
  .gramophone-object__arm {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    user-select: none;
  }

  .gramophone-object__base {
    z-index: 1;
  }

  /*
    Disco en perspectiva:
    - Posiciones relativas al lienzo cuadrado 1:1.
    - El alto ya está bien.
    - Se amplía el ancho y se ajusta left para conservar el centro.
  */
  .gramophone-object__record-plane {
    position: absolute;
    z-index: 2;

    /*
      Centro horizontal mantenido en 49.75%.
      Antes: left 38% + width 23.5% / 2 = 49.75%.
      Ahora: left 33.25% + width 33% / 2 = 49.75%.
    */
    left: 31.4%;
    top: 47.4%;
    width: 37%;
    height: 14.5%;

    display: block;
    overflow: hidden;

    border-radius: 50%;
    clip-path: ellipse(50% 50% at 50% 50%);

    transform: rotate(-2.5deg);
    pointer-events: none;
    user-select: none;

    background:
      radial-gradient(ellipse at 50% 50%, #78440f 0 18%, #3c1908 19% 25%, transparent 26%),
      radial-gradient(ellipse at 50% 52%, #28100a 0 48%, #140504 49% 100%);

    box-shadow:
      0 4px 10px rgba(0, 0, 0, 0.48),
      inset 0 1px 2px rgba(255, 245, 221, 0.2),
      inset 0 -3px 6px rgba(0, 0, 0, 0.62);

    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .gramophone-object__record-surface {
    position: absolute;

    /*
      Superficie más grande que la elipse, para que el giro cubra todo el disco.
    */
    inset: -95% -42%;

    border-radius: 50%;
    clip-path: ellipse(50% 50% at 50% 50%);

    background:
      conic-gradient(
        from 0deg,
        #180705 0deg,
        #260e07 30deg,
        #0d0302 68deg,
        #331408 112deg,
        #140504 158deg,
        #3a1708 208deg,
        #0f0302 268deg,
        #260d06 318deg,
        #180705 360deg
      ),
      repeating-radial-gradient(
        circle at 50% 50%,
        #0d0302 0 3px,
        #260d06 4px 5px,
        #110403 6px 8px,
        #1d0905 9px 10px
      );

    opacity: 1;
    transform-origin: 50% 50%;
    animation: gramophone-record-surface-spin 1.9s linear infinite;
    animation-play-state: paused;
  }

  .gramophone-object__record-plane::before {
    content: "";
    position: absolute;
    inset: 4% 3%;
    z-index: 1;

    border-radius: 50%;
    clip-path: ellipse(50% 50% at 50% 50%);

    background:
      linear-gradient(
        115deg,
        transparent 0%,
        rgba(255, 222, 150, 0.13) 18%,
        transparent 34%,
        rgba(255, 245, 221, 0.075) 48%,
        transparent 68%
      ),
      repeating-radial-gradient(
        ellipse at 50% 50%,
        transparent 0 4px,
        rgba(255, 245, 221, 0.055) 5px 6px,
        transparent 7px 10px
      );
    pointer-events: none;
  }

  .gramophone-object__record-label {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;

    display: block;
    width: 38%;
    height: 52%;

    border-radius: 50%;
    clip-path: ellipse(50% 50% at 50% 50%);

    background:
      radial-gradient(ellipse at 50% 35%, rgba(230, 201, 121, 0.5), transparent 62%),
      #75420f;

    transform: translate(-50%, -50%);

    box-shadow:
      inset 0 1px 2px rgba(255, 245, 221, 0.24),
      0 1px 4px rgba(0, 0, 0, 0.38);
  }

  .gramophone-object.is-playing .gramophone-object__record-surface {
    animation-play-state: running;
  }

  .gramophone-object.is-changing-record .gramophone-object__record-plane {
    opacity: 0;
    transform: rotate(-2.5deg) scale(0.88);
  }

  /*
    Brazo:
    Pivote calibrado sobre el frame completo 1024x1024.
  */
    /*
    Brazo:
    El pivote debe quedar fijo en la unión del brazo con el soporte vertical.
    Estos porcentajes se calculan sobre el frame completo 1024x1024 del PNG.
  */
  .gramophone-object {
    --arm-pivot-x: 69%;
    --arm-pivot-y: 45%;
    --arm-rest-angle: 4deg;
    --arm-play-angle: -5deg;
  }

  .gramophone-object__arm {
    z-index: 3;
    transform-origin: var(--arm-pivot-x) var(--arm-pivot-y);
    transform: rotate(var(--arm-rest-angle));
    transition: transform 260ms ease;
  }

  .gramophone-object.is-playing .gramophone-object__arm {
    transform: rotate(var(--arm-play-angle));
  }

  /*
    Marcador temporal del pivote.
    Para activarlo, cambia el div principal temporalmente a:
    <div class="gramophone-object" data-gramophone data-debug-pivot="true">
  */
  .gramophone-object[data-debug-pivot="true"]::after {
    content: "";
    position: absolute;
    z-index: 20;
    left: var(--arm-pivot-x);
    top: var(--arm-pivot-y);
    width: 9px;
    height: 9px;
    border: 2px solid white;
    border-radius: 999px;
    background: red;
    box-shadow: 0 0 0 3px rgba(255, 0, 0, 0.28);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  /*
    Notas musicales:
    Ubicadas hacia la bocina.
  */
  .gramophone-object__notes {
    position: absolute;
    z-index: 4;
    left: 20%;
    top: 3%;
    width: 26%;
    height: 24%;
    pointer-events: none;
  }

  .gramophone-object__note {
    position: absolute;
    left: 58%;
    top: 72%;
    color: rgba(241, 226, 191, 0.82);
    font-size: clamp(0.72rem, 1.45vw, 1.02rem);
    font-weight: 900;
    line-height: 1;
    opacity: 0;
    text-shadow:
      0 2px 8px rgba(0, 0, 0, 0.55),
      0 0 8px rgba(201, 162, 77, 0.16);
    transform: translate3d(0, 0, 0) scale(0.78);
  }

  .gramophone-object.is-playing .gramophone-object__note--one {
    animation: gramophone-note-float-one 3s ease-in-out infinite;
  }

  .gramophone-object.is-playing .gramophone-object__note--two {
    animation: gramophone-note-float-two 3.4s ease-in-out 0.45s infinite;
  }

  .gramophone-object.is-playing .gramophone-object__note--three {
    animation: gramophone-note-float-three 3.2s ease-in-out 0.9s infinite;
  }

  .gramophone-object.is-playing .gramophone-object__note--four {
    animation: gramophone-note-float-four 3.8s ease-in-out 1.25s infinite;
  }

  @keyframes gramophone-record-surface-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes gramophone-note-float-one {
    0% {
      opacity: 0;
      transform: translate3d(0, 0, 0) scale(0.62) rotate(-8deg);
    }

    18% {
      opacity: 0.78;
    }

    100% {
      opacity: 0;
      transform: translate3d(-34px, -78px, 0) scale(0.94) rotate(14deg);
    }
  }

  @keyframes gramophone-note-float-two {
    0% {
      opacity: 0;
      transform: translate3d(0, 0, 0) scale(0.6) rotate(8deg);
    }

    18% {
      opacity: 0.7;
    }

    100% {
      opacity: 0;
      transform: translate3d(-8px, -94px, 0) scale(0.98) rotate(-12deg);
    }
  }

  @keyframes gramophone-note-float-three {
    0% {
      opacity: 0;
      transform: translate3d(0, 0, 0) scale(0.64) rotate(-4deg);
    }

    18% {
      opacity: 0.74;
    }

    100% {
      opacity: 0;
      transform: translate3d(22px, -82px, 0) scale(0.92) rotate(10deg);
    }
  }

  @keyframes gramophone-note-float-four {
    0% {
      opacity: 0;
      transform: translate3d(0, 0, 0) scale(0.58) rotate(6deg);
    }

    18% {
      opacity: 0.58;
    }

    100% {
      opacity: 0;
      transform: translate3d(-48px, -54px, 0) scale(0.86) rotate(-16deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gramophone-object,
    .gramophone-object__record-plane,
    .gramophone-object__record-surface,
    .gramophone-object__note,
    .gramophone-object__arm {
      animation: none !important;
      transition: none !important;
    }
  }
</style>